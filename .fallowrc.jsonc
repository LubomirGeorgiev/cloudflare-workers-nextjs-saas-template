{
  // Real dependencies that no import statement points at, so static analysis cannot see them.
  "ignoreDependencies": [
    // Optional peers hono-openapi resolves by name: the first converts Valibot schemas when the
    // build-time generator runs, the second validates requests at runtime.
    "@valibot/to-json-schema",
    "@hono/standard-validator",
    // Rasterizer for the favicon entries. Imported, but only by `scripts/generate-logo-assets.mjs`,
    // which fallow reads as production code and so rejects the devDependency it is.
    "sharp",
    // Optional peers vinext resolves by name for the App Router (`vinext/dist/utils/project.js`).
    "@vitejs/plugin-rsc",
    "react-server-dom-webpack",
    // Required peer of vinext, which imports it for SSR and hydration; only tests import it directly.
    "react-dom",
    // Loaded by `@plugin` in `src/app/globals.css` at build time; the Worker never imports it.
    "@tailwindcss/typography"
  ],
  // Loaded by path, not by import: the vite plugin in tools/ spawns the generator, which aliases
  // these stubs into the module graph it builds.
  "dynamicallyLoaded": [
    "scripts/utils/**",
    // The internal document's generator config. Loaded by path from
    // `scripts/generate-openapi.mjs`, exactly as `src/api/openapi.ts` is — that one is also
    // imported normally by `src/api/operation.ts`, so only this one looks unreachable.
    "src/api/admin/openapi.ts",
    // Metadata routes call these exports through dynamic imports.
    "src/lib/og/content-og-image.tsx"
  ],
  // Vendored shadcn kit: each file exports its full slot set so forks can use the parts the
  // template does not. The oxlint `project/no-unused-module-exports` line disables record the same choice.
  "ignoreExports": [{ "file": "src/components/ui/**", "exports": ["*"] }],
  "health": {
    "ignore": [
      // Vendored upstream rules (see tools/oxlint/anti-slop/UPSTREAM.md). Upstream owns their structure.
      "tools/oxlint/anti-slop/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "**/*.spec.ts",
      "**/*.spec.tsx",
      "tests/**"
    ]
  },
  "duplicates": {
    "ignore": [
      // Vendored upstream rules (see tools/oxlint/anti-slop/UPSTREAM.md). Upstream owns their structure.
      "tools/oxlint/anti-slop/**",
      "worker-configuration.d.ts"
    ]
  }
}
