{
    "$schema": "node_modules/wrangler/config-schema.json",
    "account_id": "0d5667a195a90458761fe59fca898f9c",
    "name": "cloudflare-workers-nextjs-saas-template",
    "main": "./worker-entrypoint.ts",
    "preview_urls": true,
    "routes": [
      {
        "pattern": "nextjs-saas-template.lubomirgeorgiev.com",
        "custom_domain": true
      }
    ],
    "compatibility_date": "2026-08-03",
    // `global_fetch_strictly_public` is required by the OAuth provider's CIMD support: client_id
    // metadata documents are fetched from the public internet, never looped back into this Worker.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
      "directory": "dist/client",
      "binding": "ASSETS",
      "not_found_handling": "none"
    },
    "images": {
      "binding": "IMAGES"
    },
    "cache": {
      "enabled": true,
    },
    "observability": {
      "enabled": true,
      "logs": {
        "enabled": true
      },
      "traces": {
        "enabled": true,
      }
    },
    "upload_source_maps": true,
    "placement": { "mode": "smart" },
    "triggers": {
      "crons": ["*/5 * * * *"]
    },
    "queues": {
      "producers": [
        {
          "binding": "SCHEDULER_QUEUE",
          "queue": "cloudflare-workers-nextjs-saas-template-scheduler"
        }
      ],
      "consumers": [
        {
          "queue": "cloudflare-workers-nextjs-saas-template-scheduler",
          "max_batch_size": 20,
          "max_batch_timeout": 5,
          "max_retries": 5,
          "retry_delay": 60
        }
      ]
    },


    "ai": {
      "binding": "AI"
    },
    "vars": {
        "APP_TEST_MODE": "false",
        "EMAIL_FROM": "no-reply@notifications.lubomirgeorgiev.com",
        "EMAIL_FROM_NAME": "Lubomir Georgiev",
        "EMAIL_REPLY_TO": "lubo@lubomirgeorgiev.com"
    },
    "send_email": [
        {
            "name": "EMAIL",
            "allowed_sender_addresses": [
                "no-reply@notifications.lubomirgeorgiev.com"
            ],
            "remote": true
        }
    ],
    "d1_databases": [
        {
            "binding": "NEXT_TAG_CACHE_D1",
            "database_name": "cloudflare-workers-nextjs-saas",
            "database_id": "db968793-55f4-481e-b281-7e1907a775b1",
            "migrations_dir": "src/db/migrations",
            "migrations_pattern": "src/db/migrations/*/migration.sql"
        }
    ],
    "kv_namespaces": [
        {
            "binding": "NEXT_INC_CACHE_KV",
            "id": "e922d6e22f4a46b6a92be653e90c6ca1"
        },
        // Second binding onto the SAME namespace: @cloudflare/workers-oauth-provider hardcodes the
        // `OAUTH_KV` binding name, and forking the template must not require provisioning anything
        // extra. Its keys are prefix-scoped (see OAUTH_RESERVED_KV_PREFIXES in src/constants.ts);
        // re-audit those prefixes whenever the library is upgraded.
        {
            "binding": "OAUTH_KV",
            "id": "e922d6e22f4a46b6a92be653e90c6ca1"
        }
    ],
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["DOQueueHandler"]
        },
        {
            "tag": "v2",
            "deleted_classes": ["DOQueueHandler"]
        }
    ],
    "r2_buckets": [
        {
            "binding": "NEXT_INC_CACHE_R2_BUCKET",
            "bucket_name": "cloudflare-workers-nextjs-saas-template"
        }
    ]
  }
