{
  "name": "cloudflare-workers-nextjs-saas-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules/.vite node_modules/.vite-vinext node_modules/.vite-openapi node_modules/.vite-temp .vinext/cache dist vinext worker worker-dist",
    "dev": "vinext dev",
    "build": "vinext build --verbose",
    "analyze:bundle": "ANALYZE_BUNDLE=1 pnpm build",
    "build:prod": "vinext-cloudflare deploy --dry-run",
    "start": "vinext start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:vinext": "vinext check",
    "check:startup": "pnpm build && wrangler check startup -c dist/server/wrangler.json",
    "openapi:generate": "node scripts/generate-openapi.mjs",
    "logo:generate": "node scripts/generate-logo-assets.mjs",
    "email:preview": "node scripts/preview-emails.mjs",
    "metrics:report": "node scripts/render-metrics-report.mjs",
    "typecheck": "tsc --noEmit",
    "deploy": "vinext-cloudflare deploy",
    "preview": "NEXT_PUBLIC_SITE_URL=http://localhost:8787 pnpm build && wrangler dev --port 8787 --host localhost:8787 ${WRANGLER_DEV_ARGS:-}",
    "deploy:dryrun": "pnpm build && wrangler deploy --outdir worker-dist --dry-run",
    "cf-typegen": "wrangler types --env-file .env.example",
    "db:generate": "drizzle-kit generate --name",
    "db:migrate:dev": "echo yes | wrangler d1 migrations apply $(node scripts/get-db-name.mjs) --local",
    "reset": "rm -rf .wrangler && pnpm db:migrate:dev && pnpm db:seed",
    "db:seed": "wrangler d1 execute $(node scripts/get-db-name.mjs) --local --file=./src/db/seed.sql",
    "stripe:setup": "node --env-file-if-exists=.env scripts/stripe-setup.mjs",
    "postinstall": "pnpm run cf-typegen"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@base-ui/react": "^1.7.0",
    "@cloudflare/workers-oauth-provider": "^0.10.2",
    "@floating-ui/react": "^0.27.16",
    "@hono/standard-validator": "^0.2.3",
    "@hookform/resolvers": "^5.4.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "@marsidev/react-turnstile": "^1.5.2",
    "@modelcontextprotocol/server": "^2.0.0",
    "@oslojs/encoding": "^1.1.0",
    "@simplewebauthn/browser": "^13.1.0",
    "@simplewebauthn/server": "^13.1.1",
    "@stripe/react-stripe-js": "^6.7.0",
    "@stripe/stripe-js": "^9.9.0",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.13.0",
    "@tiptap/extension-code-block-lowlight": "^3.13.0",
    "@tiptap/extension-highlight": "^3.13.0",
    "@tiptap/extension-horizontal-rule": "^3.13.0",
    "@tiptap/extension-image": "^3.13.0",
    "@tiptap/extension-list": "^3.13.0",
    "@tiptap/extension-subscript": "^3.13.0",
    "@tiptap/extension-superscript": "^3.13.0",
    "@tiptap/extension-table": "^3.13.0",
    "@tiptap/extension-text-align": "^3.13.0",
    "@tiptap/extension-typography": "^3.13.0",
    "@tiptap/extensions": "^3.13.0",
    "@tiptap/markdown": "^3.13.0",
    "@tiptap/pm": "^3.13.0",
    "@tiptap/react": "^3.13.0",
    "@tiptap/starter-kit": "^3.13.0",
    "@tiptap/static-renderer": "^3.13.0",
    "@valibot/to-json-schema": "^1.7.1",
    "agents": "^0.20.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.3.0",
    "diff": "^9.0.0",
    "drizzle-orm": "1.0.0-rc.4",
    "file-type": "^21.1.1",
    "highlight.js": "~11.11.1",
    "hono": "^4.12.32",
    "hono-openapi": "^1.3.1",
    "image-size": "^2.0.2",
    "ipaddr.js": "^2.2.0",
    "lodash.throttle": "^4.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "1.25.0",
    "motion": "^12.42.2",
    "ms": "^2.1.3",
    "next": "16.2.7",
    "next-intl": "^4.13.1",
    "next-safe-action": "^8.6.0",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.8.16",
    "nuqs": "^2.8.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.78.0",
    "react-hotkeys-hook": "^5.2.1",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "remeda": "^2.22.1",
    "server-only": "^0.0.1",
    "slugify": "^1.6.6",
    "sonner": "^2.0.7",
    "stripe": "^22.3.0",
    "tailwind-merge": "^3.6.0",
    "ua-parser-js": "^2.0.0",
    "unified": "^11.0.5",
    "use-sync-external-store": "1.6.0",
    "usehooks-ts": "^3.1.1",
    "valibot": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.51.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "@types/lodash.throttle": "^4.1.9",
    "@types/ms": "2.1.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript/typescript6": "^6.0.2",
    "@vinext/cloudflare": "1.0.0-beta.6",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "1.0.0-rc.4",
    "jsonc-parser": "^3.3.1",
    "openapi-types": "^12.1.3",
    "oxlint": "^1.75.0",
    "playwright": "^1.60.1",
    "react-server-dom-webpack": "^19.2.8",
    "sass": "^1.99.0",
    "schema-dts": "^1.1.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7",
    "vinext": "1.0.0-beta.6",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
